// Products Example
// Demonstrates product catalog with calculated fields

discount := 0.10

products [
  template { id, name, price }
  
  map (p) = {
    id = p.id
    name = p.name
    price = p.price
    hasDiscount = p.price > 100
    finalPrice = p.price > 100 ? p.price * (1 - discount) : p.price
    inStock = true
  }
  
  1, "Laptop", 999.99
  2, "Mouse", 29.99
  3, "Keyboard", 79.99
  4, "Monitor", 299.99
  5, "Headphones", 149.99
]